<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Barrapp.Application\Barrapp.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Base de conocimiento: JSON versionado embebido, cargado y validado al arrancar (#63). -->
    <EmbeddedResource Include="../../knowledge/exercises.json" LogicalName="knowledge.exercises.json" />
    <EmbeddedResource Include="../../knowledge/skills.json" LogicalName="knowledge.skills.json" />
    <EmbeddedResource Include="../../knowledge/routines.json" LogicalName="knowledge.routines.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Solo herramienta de tiempo de diseño (dotnet ef): no fluye al runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Barrapp.Persistence.IntegrationTests" />
  </ItemGroup>

</Project>
