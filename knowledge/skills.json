          ]
        },
        {
          "id": "r3",
          "name": "Modelo R3",
          "intensity": 2,
          "equipment": "Solo barra baja",
          "items": [
            { "exerciseId": "front-lever-advanced-tuck", "sets": 2, "holdSecondsMin": 10, "holdSecondsMax": 10, "restSeconds": 90 },
