          ]
        },
        {
          "id": "r5",
          "name": "Modelo R5",
          "intensity": 3,
          "equipment": "Barra alta y baja",
          "items": [
            { "exerciseId": "front-lever-full", "sets": 4, "holdSecondsMin": 3, "holdSecondsMax": 8, "restSeconds": 210, "notes": "Intentos front lever full, banda fina en cadera y pies." },
