{
  "schemaVersion": 1,
  "skills": [
    {
      "id": "handstand",
      "name": "Pino",
      "group": "push",
      "lever": false,
      "stages": [
        { "order": 1, "name": "Pino en pared", "exerciseId": "handstand-wall-support", "criterion": { "metric": "seconds", "target": 30, "sets": 3 }, "notes": "Pies apoyados en la pared, cuerpo alineado y hombros activos." },
        { "order": 2, "name": "Pino de espaldas a la pared", "exerciseId": "handstand-back-to-wall", "criterion": { "metric": "seconds", "target": 30, "sets": 3 }, "notes": "Sin apoyo de pies; los talones rozan la pared." },
        { "order": 3, "name": "Pino de pecho a la pared", "exerciseId": "handstand-chest-to-wall", "criterion": { "metric": "seconds", "target": 45, "sets": 3 }, "notes": "Pecho a la pared, cuerpo en línea y mirada entre las manos." },
        { "order": 4, "name": "Pino libre con entrada", "exerciseId": "handstand-kick-up", "criterion": { "metric": "seconds", "target": 5, "sets": 5 }, "notes": "Entrada a pino sin pared; aún con apoyos puntuales." },
        { "order": 5, "name": "Pino libre", "exerciseId": "handstand-freestanding", "criterion": { "metric": "seconds", "target": 10, "sets": 3 }, "notes": "Mantener sin pared, respirando con calma." }
      ],
      "patternRoutines": [
        {
          "id": "r1",
          "name": "Modelo R1",
          "intensity": 2,
          "equipment": "Pared",
          "items": [
            { "exerciseId": "elevated-pike-push-up", "sets": 3, "repsMin": 5, "repsMax": 8, "restSeconds": 120 },
            { "exerciseId": "handstand-push-up", "sets": 3, "repsMin": 3, "repsMax": 5, "restSeconds": 150 },
            { "exerciseId": "handstand-shrug", "sets": 3, "repsMin": 6, "repsMax": 8, "restSeconds": 90 },
            { "exerciseId": "wall-walk", "sets": 3, "repsMin": 8, "repsMax": 10, "restSeconds": 90, "notes": "Pasos." }
          ]
        }
      ]
    },
    {
      "id": "front-lever",
      "name": "Front lever",
      "group": "pull",
      "lever": true,
      "stages": [
        { "order": 1, "name": "Front lever agrupado", "exerciseId": "front-lever-tuck", "criterion": { "metric": "seconds", "target": 15, "sets": 3 }, "notes": "Rodillas al pecho, espalda recta y escápulas activas." },
        { "order": 2, "name": "Front lever agrupado avanzado", "exerciseId": "front-lever-advanced-tuck", "criterion": { "metric": "seconds", "target": 10, "sets": 3 }, "notes": "Cadera abierta y rodillas fuera de la línea del torso." },
        { "order": 3, "name": "Front lever a una pierna", "exerciseId": "front-lever-one-leg", "criterion": { "metric": "seconds", "target": 8, "sets": 3 }, "notes": "Una pierna extendida y la otra recogida." },
        { "order": 4, "name": "Front lever con piernas abiertas", "exerciseId": "front-lever-straddle", "criterion": { "metric": "seconds", "target": 5, "sets": 3 }, "notes": "Piernas extendidas y separadas; cadera a la altura de los hombros." },
        { "order": 5, "name": "Front lever completo", "exerciseId": "front-lever-full", "criterion": { "metric": "seconds", "target": 5, "sets": 3 }, "notes": "Cuerpo horizontal y paralelo al suelo." }
      ],
      "patternRoutines": [
        {
          "id": "r1",
          "name": "Modelo R1",
          "intensity": 2,
          "equipment": "Barra alta y baja",
